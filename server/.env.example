# ====================================================
# PORTFOLIO BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE)
# Place real secrets in .env (never commit .env to Git)
# ====================================================

NODE_ENV=development
PORT=5000

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/portfolio?retryWrites=true&w=majority

# Frontend Origin for CORS and Cookie Domain
FRONTEND_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
JWT_ISSUER=portfolio-cms
JWT_AUDIENCE=portfolio-admin

# Initial Admin User CLI Provisioning (used by npm run seed:admin)
ADMIN_EMAIL=admin@bharani.dev
ADMIN_INITIAL_PASSWORD=ChangeMe_SecurePassword_2026!

# Resend Email Configuration (for Contact Form notifications)
RESEND_API_KEY=re_123456789_placeholder
CONTACT_NOTIFICATION_EMAIL=admin@bharani.dev
RESEND_FROM_EMAIL=onboarding@resend.dev
